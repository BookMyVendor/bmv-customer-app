{
  "expo": {
    "name": "bmvCustomerApp",
    "slug": "bmvCustomerApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bmv_internal_logo.png",
    "scheme": "bmvcustomerapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/bmv_internal_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bnt.bmv.customerapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/bmv_internal_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow BookMyVendors to access your contacts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}